{
  "name": "honghub-desktop",
  "version": "1.7.85",
  "description": "鸿汇影 · 免费桌面版：双端隔离（开发端运维面板 / 客户端纯净影视页）+ 远程问题自动收集 + 实时更新 + 可扩展功能 + 一键自愈 + 换版免人工",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server/server.js",
    "desktop": "node server/server.js",
    "build:app": "python build_desktop.py",
    "pack": "node scripts/build-exe.js && node scripts/auto-release.js",
    "docs:desktop": "node scripts/desktop-docs.js",
    "oneclick": "node scripts/oneclick-release.js",
    "auto:watch": "node scripts/auto-publish-watch.js",
    "verify": "node scripts/verify-release.js",
    "purity": "node scripts/check-client-purity.js",
    "test:bugfix": "node scripts/selftest-bugfix.js",
    "test:feature": "node scripts/selftest-feature-flow.js",
    "batch": "node scripts/build-archs.js",
    "check": "node scripts/check-static.js",
    "check:features": "node scripts/check-feature-wiring.js",
    "doctor": "node scripts/doctor.js",
    "signing:setup": "node scripts/setup-signing.js",
    "signing:connect": "node scripts/signing-connect.js",
    "signing:connect:check": "node scripts/signing-connect.js --check",
    "signing:connect:selftest-cert": "node scripts/signing-connect.js --make-selftest",
    "hap:sign": "node scripts/hap-sign.js",
    "smoke:hap": "node scripts/smoke-hap.js",
    "hap:watch": "node scripts/hap-watch.js",
    "smoke:ui": "node scripts/smoke-ui.js",
    "archive": "node scripts/archive-release.js",
    "archive:prune": "node scripts/prune-and-archive.js",
    "archive:prune:dry": "node scripts/prune-and-archive.js --dry",
    "dist:clean": "node scripts/dist-cleanup.js",
    "dist:clean:apply": "node scripts/dist-cleanup.js --apply",
    "sign:win": "node scripts/sign-windows.js",
    "sign:test": "node scripts/sign-windows.js --selftest",
    "publish:remote": "node scripts/publish-remote.js",
    "ship": "node scripts/ship.js",
    "ship:patch": "node scripts/ship.js --patch",
    "ship:verify": "node scripts/ship.js --verify",
    "ship:deliver": "node scripts/ship.js --deliver",
    "ship:client": "node scripts/ship-client.js",
    "version": "node scripts/version.js",
    "version:check": "node scripts/version.js --check",
    "version:sync": "node scripts/version.js --sync",
    "version:bump": "node scripts/version.js --bump",
    "verify:dev-auto": "node scripts/verify-dev-auto.js",
    "sources:verify": "node scripts/verify-sources.js",
    "sources:chunk": "node scripts/verify-sources.js --chunk=300",
    "sources:status": "node scripts/verify-sources.js --status",
    "deploy:sites": "node scripts/deploy-sites.js",
    "verify:online": "node scripts/deploy-sites.js --verify-only",
    "verify:online:deep": "node scripts/deploy-sites.js --verify-only --deep",
    "verify:e2e": "node scripts/verify-e2e.js",
    "maintain": "node scripts/dev-maintain.js",
    "maintain:quick": "node scripts/dev-maintain.js --quick",
    "auto:release": "node scripts/auto-release.js",
    "hap:device": "node scripts/hap-device.js --run",
    "hap:install": "node scripts/hap-device.js --install",
    "hap:shot": "node scripts/hap-device.js --shot",
    "sites:sync": "node scripts/sync-sites.js",
    "sbom": "node scripts/sbom.js",
    "audit": "node scripts/sbom.js",
    "hooks:install": "node scripts/install-hooks.js",
    "dev:auto": "node scripts/dev-auto.mjs",
    "dev:auto:check": "node scripts/dev-auto.mjs --check",
    "build:dev-scripts": "node scripts/build-dev-package.js",
    "build:client": "node scripts/build-client-exe.js",
    "publish:free": "node scripts/publish-free.js",
    "publish:free:verify": "node scripts/publish-free.js --verify",
    "site:check": "node scripts/site-publish.js",
    "site:verify": "node scripts/site-publish.js --verify"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.65.1"
  },
  "build": {
    "appId": "com.honghub.desktop",
    "productName": "鸿汇影桌面版",
    "asar": false,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "icon": "assets/icon.ico",
    "files": [
      "app/**/*",
      "server/**/*",
      "features/**/*",
      "assets/**/*",
      "electron-main.js",
      "preload.js",
      "dev-auto-update.js",
      "build_desktop.py",
      "package.json",
      "!server/data/*.jsonl",
      "!server/data/*.json",
      "!server/data/access-token.txt",
      "!server/data/app.page.html",
      "!server/data/app.page.json",
      "!server/data/snapshots/**",
      "!server/data/catalog-backups/**",
      "!server/data/*.gz",
      "!server/data/*.md",
      "!server/data/*.txt",
      "!server/data/catalog-snapshot-*.json",
      "!server/data/manifest.before-*.json",
      "!**/*.bak",
      "!**/*.log",
      "!**/*.dev-backup"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "鸿汇影桌面版",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "license": "MIT",
  "author": "HongHub"
}
